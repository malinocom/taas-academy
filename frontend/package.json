{
  "name": "consulting-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:frontend": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:backend": "cd ../backend && npm ci && npm run build",
    "start:backend": "cd ../backend && npm run start",
