PORT=4000
NODE_ENV=development

# Add the local Vite origin and the production frontend origin.
FRONTEND_ORIGINS=http://localhost:5173,https://taas.runflare.run

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Use long, random, separate secrets for access and refresh tokens.
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_REFRESH_SECRET
ACCESS_TOKEN_TTL_SECONDS=86400
REFRESH_TOKEN_TTL_SECONDS=2592000

# Local development defaults. For production set NODE_ENV=production and COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000
BACKEND_URL=http://localhost:4000
